.screen {
    flex-grow: 1;
    background-image: url("/Assets/UI/Sprites/nebula-blue.png");
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    background-color: green;
}

.menu-column {
    width: 50%;
    justify-content: center;
    align-items: center;
    padding-left: 0;
    padding-top: 0;
}

.title {
    font-size: 70px;
    -unity-font-style: bold;
    color: var(--color-text);        
    -unity-text-align: middle-left;
    margin: 0;
}

.subtitle {
    font-size: 26px;
    color: var(--color-primary);
    letter-spacing: 10px;
    -unity-text-align: middle-left;
    margin-bottom: 60px;
}

.button-group {
    align-items: flex-start;
    margin-top: 16px;
}

.btn {
    width: var(--menu-btn-width);
    height: var(--menu-btn-height);
    margin: 0 0 18px 0;
    padding: 0 0 0 40px;

    font-size: var(--menu-text-size);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--color-text);

    background-color: rgba(0, 200, 255, 0);
    border-width: var(--menu-border-width);
    border-color: var(--color-border-soft);
    border-radius: var(--menu-btn-radius);

    transition-property: background-color, color, border-color, translate;
    transition-duration: var(--anim-time);
    transition-timing-function: ease-out;
}

.btn:hover,
.btn:focus {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-on-primary);
    translate: 16px 0;       
}

.btn:active {
    background-color: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
}

.btn-primary {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-on-primary);
}

.btn-primary:hover,
.btn-primary:focus {
    background-color: var(--color-text);
    border-color: var(--color-text);
}


.btn-quiet {
    color: var(--color-text-muted);
    border-color: rgba(150, 170, 210, 0.25);
}

.best-score {
    position: absolute;
    left: 120px;
    bottom: 40px;
    font-size: 24px;
    color: var(--color-text-muted);
    letter-spacing: 3px;
}

.version {
    position: absolute;
    right: 30px;
    bottom: 30px;
    font-size: 20px;
    color: var(--color-text-muted);
}



.hidden { display: none; }

.settings-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(4, 8, 24, 0.85);
    align-items: center;
    justify-content: center;
}

.settings-card {
    width: 700px;
    padding: 40px 50px;
    background-color: var(--color-surface);
    border-width: 2px;
    border-color: var(--color-border-soft);
    border-radius: 30px;
}

.settings-title {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 20px;
}

.settings-section {
    font-size: 22px;
    letter-spacing: 6px;
    color: var(--color-primary);
    margin: 20px 0 8px 0;
}

.setting-row { margin: 6px 0; }
.setting-row > .unity-base-field__label,
.setting-row .unity-label { color: var(--color-text); font-size: 24px; min-width: 200px; }

.setting-row .unity-base-slider__dragger { background-color: var(--color-primary); }
.setting-row .unity-base-slider__tracker { background-color: rgba(150, 170, 210, 0.3); }