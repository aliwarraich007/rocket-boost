<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
<ui:Style src="/Assets/UI Toolkit/MainMenu.uss" />   
    <ui:VisualElement name="main-container" class="screen">

        <ui:VisualElement name="menu-column" class="menu-column">
            <ui:Label name="title" text="ROCKET BOOST" class="title" />

            <ui:VisualElement class="button-group">
                <ui:Button name="launch-btn"   text="LAUNCH"   class="btn btn-primary" />
                <ui:Button name="hangar-btn"   text="Levels"   class="btn" />
                <!-- <ui:Button name="missions-btn" text="MISSIONS" class="btn" /> -->
                <ui:Button name="settings-btn" text="SETTINGS" class="btn" />
                <ui:Button name="quit-btn"     text="QUIT"     class="btn btn-quiet" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- <ui:Label name="best-score" text="BEST ALTITUDE: 0 m" class="best-score" /> -->


       <ui:VisualElement name="settings-panel" class="settings-overlay hidden">
            <ui:VisualElement class="settings-card">
                <ui:Label text="SETTINGS" class="settings-title" />

                <ui:Label text="AUDIO" class="settings-section" />
                <ui:Slider name="master-slider" label="Master" low-value="0" high-value="1" class="setting-row" />
                <ui:Slider name="music-slider"  label="Music"  low-value="0" high-value="1" class="setting-row" />
                <ui:Slider name="sfx-slider"    label="SFX"    low-value="0" high-value="1" class="setting-row" />

                 <ui:Label text="GRAPHICS" class="settings-section" />
                 <ui:DropdownField name="quality-dropdown"    label="Quality"    class="setting-row" />
                 <ui:DropdownField name="resolution-dropdown" label="Resolution" class="setting-row" />
                 <ui:Toggle name="fullscreen-toggle" label="Fullscreen" class="setting-row" />
                 <ui:Toggle name="vsync-toggle"      label="VSync"      class="setting-row" />

                <ui:Button name="settings-back-btn" text="BACK" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="version" text="v0.1" class="version" />

    </ui:VisualElement>
</ui:UXML>